# Copy to .env and fill in what you need. Never commit .env.
#
# Only ANTHROPIC_API_KEY is needed to draft an issue. Every gather source and
# the delivery step degrade gracefully when their key is absent: the stage
# writes a stub, the run continues, and the draft notes the section is thin.
# `--demo` runs the whole pipeline with no keys at all.

# Synthesis (required for a real draft)
ANTHROPIC_API_KEY=

# Web search gather source (optional) -- https://exa.ai
EXA_API_KEY=

# X/Twitter discourse gather source (optional) -- https://console.x.ai
# Set a spend limit before the first run: tool calls bill on top of tokens.
XAI_API_KEY=
XAI_MODEL=grok-4.5

# SendGrid delivery (optional). The pipeline only ever creates DRAFTS.
SENDGRID_API_KEY=
# Written by `python -m newsletter.setup_sendgrid`
SENDGRID_SENDER_ID=
SENDGRID_LIST_ID=
SENDGRID_UNSUB_GROUP_ID=
